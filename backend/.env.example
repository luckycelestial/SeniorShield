# SeniorShield Backend — Environment Variables Template
# =====================================================

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

# Model Configuration
MODEL_PATH=models/bert-tiny-scam-v1
MODEL_DEVICE=cpu

# Groq LLM (Grounded Explanation Layer)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
GROQ_TIMEOUT_SECONDS=10.0

# Threat Intelligence (Phase 6)
THREAT_INTEL_API_KEY=your_threat_intel_api_key_here
THREAT_INTEL_PROVIDER=mock_dev_provider
THREAT_INTEL_TIMEOUT_SECONDS=2.0

# Neo4j Graph Database (Event Storage)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
