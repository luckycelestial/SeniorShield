# SeniorShield Backend — Environment Variables
# =============================================
# Copy this file and fill in real values. Never commit secrets to git.

# Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

# Model Configuration
MODEL_PATH=models/bert-tiny-scam-v1
MODEL_DEVICE=cpu

# Groq LLM (Grounded Explanation Layer)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
GROQ_TIMEOUT_SECONDS=3.0

# Threat Intelligence (Phase 6)
THREAT_INTEL_PROVIDER=mock_dev_provider
THREAT_INTEL_TIMEOUT_SECONDS=2.0
